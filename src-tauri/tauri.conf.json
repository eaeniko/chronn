{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Work Timer",
  "mainBinaryName": "work-timer",
  "version": "0.5.0",
  "identifier": "io.github.eaeniko.worktimer",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-gpu"
      },
      {
        "label": "dock",
        "title": "",
        "url": "dock.html",
        "width": 240,
        "height": 46,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-gpu"
      },
      {
        "label": "aviso",
        "title": "",
        "url": "aviso.html",
        "width": 300,
        "height": 40,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-gpu"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "eaeniko",
    "copyright": "© 2026 Nikolai Cinotti (@eaeniko)",
    "externalBin": ["binaries/work-timer-hook"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "template": "gen/nsis/instalador.nsi",
        "languages": ["English", "PortugueseBR"],
        "displayLanguageSelector": false,
        "customLanguageFiles": { "English": "nsis/idiomas/English.nsh", "PortugueseBR": "nsis/idiomas/PortugueseBR.nsh" }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDMENFOTcwODk0QTdFQUEKUldTcWZrcUpjT2tNcklZV1dhMGZpNVBzaUtrcGsyM2lkMm45ZmNvTHBPUmhTRHZZL1lWNUJkSlEK",
      "endpoints": ["https://github.com/eaeniko/chronn/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
